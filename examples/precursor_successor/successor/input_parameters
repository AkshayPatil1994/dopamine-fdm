! ================================================================
! Input parameters for dopamine-fdm solver (Fortran namelist format)
! ================================================================

&DOMAIN
  nx         = 130,
  ny         = 65,
  nz         = 66,
  Lx         = 12.0,
  Ly         = 2.0,
  Lz         = 6.0,
  alpha_grid = 2.8,
  grid_type  = 2,
  p_row      = 4,
  p_col      = 2,
/

&PHYSICS
  nu                   = 1.0e-3,
  dPdx                 = 0.0,
  dPdz                 = 0.0,
  Ub_x                 = 0.0,
  Ub_z                 = 0.0,
  T_wave_x             = 0.0,
  T_wave_z             = 0.0,
  phi_wave_x           = 0.0,     ! phase offset [rad] for x-wave forcing
  phi_wave_z           = 0.0,     ! phase offset [rad] for z-wave forcing
  sgs_model            = 1,       ! 0=DNS, 1=Vreman
  Cs_vreman            = 0.17,    ! Sub-grid model constant (Eq. 5)
  flat_wall_model_flag = 1,       ! 0=no-slip, 1=log-law EQWM
  flow_forcing_mode    = 0,       ! 0=prescribed dPdx (default), 1=constant mass flux
  Ub_target            = 0,       ! target bulk velocity, used only if flow_forcing_mode=1
  advection_scheme     = 0,       ! 0=skew-symmetric (default), 1=pure divergence-form central
/

&NUMERICS
  dt           = 5.0e-3,
  nsteps       = -200,      ! >0: run exactly nsteps steps. <0: ignore step count, run until t>=sim_end_time
  nsave        = -10,      ! >0: write a snapshot every nsave steps. <0: ignore step count, write every tsave time units
  nmonitor     = 10,
  sim_end_time = 100.0,   ! physical end time, used only when nsteps<0
  tsave        = 0.5,     ! physical save interval, used only when nsave<0
  cfl_adaptive = 1,       ! 0=fixed dt, 1=adaptive dt
  cfl_target   = 0.5,     ! target CFL number (adaptive mode)
  cfl_safety   = 1.0,     ! safety factor on dt adjustment
  dt_min       = 1.0e-8,  ! minimum allowed dt
  dt_max       = 1.0e10,  ! maximum allowed dt
/


&BOUNDARY_CONDITIONS
  bc_face_ylo = 1,
  bc_face_yhi = 1,

  x_bc_type   = 1,
  y_bc_type   = 1,
/

&INFLOW
  inflow_type             = 2,    
  inflow_recycle_file     = '../precursor/slices/precursor',
  inflow_recycle_loop     = 1,
  inflow_recycle_t_offset = 0.0,
  inflow_recycle_shift_z  = 1,  
/


&INITIAL_CONDITIONS
  Utarget      = 15,        ! For the successor simulation, this is not active!
  ic_type      = 1,         ! For the successor simulation, this is not active!
  noise_percent  = 5.0,     ! For the successor simulation, this is not active!
  nstep_init     = 0,       ! starting step number (for hot-start)
  restart        = 0,       ! 0=fresh run, 1=hot-start from filein
  scalar_restart = 1,       ! 1=read C from restart file (default)
                            ! 0=initialise C from IC even when restart=1
                            !   (use this when the restart file contains only
                            !    velocity/pressure and has no scalar block)
/

! File paths
&IO
  filein  = 'restart/successor.1',
  fileout = 'successor',
/




