! ================================================================
! UAV actuator-disk Phase 2 smoke test: a vertical takeoff, climbing
! from h/R=2 (in ground effect) to h/R=10 above the domain's own
! no-slip ground (y=0) along a prescribed path, x/z fixed (pure
! vertical climb -- horizontal-path motion is not exercised here but
! uses the same code path, see uav_actuator.f90's uav_current_center).
!
! Purpose: check the moving disk is stable through a climb and that
! the path interpolation does not introduce spurious jumps in the
! force term as the marker ring is re-centred every RK sub-stage.
! ================================================================

&DOMAIN
  nx         = 66,
  ny         = 129,
  nz         = 66,
  Lx         = 1.0,
  Ly         = 2.0,
  Lz         = 1.0,
  alpha_grid = 1.0,
  grid_type  = 1,
/

&PHYSICS
  nu                   = 1.5e-5,
  dPdx                 = 0.0,
  dPdz                 = 0.0,
  sgs_model            = 1,
  Cs_vreman            = 0.17,
  flat_wall_model_flag = 0,
/

&NUMERICS
  dt           = 1.0e-3,
  nsteps       = 800,
  nsave        = 800,
  nmonitor     = 50,
  cfl_adaptive = 1,
  cfl_target   = 0.5,
  cfl_safety   = 0.9,
  dt_min       = 1.0e-8,
  dt_max       = 1.0e-2,
/

&BOUNDARY_CONDITIONS
  bc_face_ylo = 1,   ! ground: no-slip
  bc_face_yhi = 2,   ! far top: free-slip (open)
/

&INITIAL_CONDITIONS
  Utarget      = 0.0,
  ic_type      = 3,
  noise_percent = 0.1,
  nstep_init     = 0,
  restart        = 0,
  scalar_restart = 1,
/

&IO
  filein  = 'restart/uav_takeoff.1',
  fileout = 'uav_takeoff',
/

&UAV
  uav_active       = 1,
  uav_disk_radius  = 0.15,
  uav_n_r          = 15,
  uav_n_theta      = 24,
  uav_hover_thrust = 4.0,
  uav_kernel_ncell = 2,
  uav_path_active  = 1,
  uav_path_file    = 'uav_takeoff_path.dat',
/

&STATISTICS
  n_lines = 1,
  line_freq = 20,
  line_dir(1)     = 'y',
  line_pos1(1)    = 0.5,
  line_pos2(1)    = 0.5,
  line_comps(1)   = 'V',
  line_fileout(1) = 'lines/centerline',
/
