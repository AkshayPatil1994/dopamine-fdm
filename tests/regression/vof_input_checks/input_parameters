! ================================================================
! Static liquid cylinder with surface tension, no gravity, density ratio 1000 (R=0.25, sigma=1, 32 cells across the box): the
! pressure jump must equal the Laplace value sigma/R = 4 (here to 1 %) and the parasitic currents of the balanced-force
! height-function scheme stay tiny (max|U| of the final row < 3e-5 at N=32; 4.5e-7 at N=64). Checked by tests/regression/vof_check.py on vof_diag.dat
! (column 29 = p_liquid - p_gas, column 16 = max|U|).
! ================================================================
&DOMAIN
  nx = 34, ny = 33, nz = 6, Lx = 1.03125, Ly = 1.0, Lz = 0.15625, grid_type = 1, alpha_grid = 1.0, alpha_grid_z = 0.0, p_row = 0, p_col = 0,
/
&PHYSICS
  nu = 1.0e-3, sgs_model = 0,
/
&NUMERICS
  dt = 1.0e-3, nsteps = -1, nsave = 1000000, nmonitor = 5, cfl_adaptive = 1, cfl_target = 0.4, cfl_safety = 0.9,
  dt_max = 5.0e-2, sim_end_time = 8.0,
/
&BOUNDARY_CONDITIONS
  bc_face_ylo = 2, bc_face_yhi = 2, x_bc_type = 0, y_bc_type = 1, z_bc_type = 0,
/
&INITIAL_CONDITIONS
  Utarget = 0.0, ic_type = 3, noise_percent = 0.0, restart = 0,
/
&IO
  filein = 'restart/vof_drop_small.1', fileout = 'vof_drop_small',
/
&VOF
  vof_active = 1, vof_flow = 1, vof_ic_type = 6, vof_center = 0.5, 0.5, 0.0, vof_radius = 0.25,
  vof_rho_l = 1000.0, vof_rho_g = 1.0, vof_nu_l = 1.0e-3, vof_nu_g = 1.0e-3, vof_grav = 0.0, vof_sigma = 1.0,
/
