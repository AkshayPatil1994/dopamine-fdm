! Nonlinear flume: Rienecker-Fenton stream-function wave H=0.08, T=1.2 over depth 0.5, density ratio 100.
! Stable to t=7 on 4 ranks (about 45 s); gauge amplitudes within 5 % of H/2 = 0.04; ledger residual 1.5e-6.
! The same case at density ratio 1000 develops an exponentially growing air-side instability near the generation zone from t~2 s and
! diverges at t~6 s (open gas-phase problem: see the project notes); linear waves at ratio 1000 are fine.
&DOMAIN
  nx = 194, ny = 33, nz = 6,
  Lx = 6.03125, Ly = 1.0, Lz = 0.15625,
  grid_type = 1, alpha_grid = 1.0, alpha_grid_z = 0.0, p_row = 0, p_col = 0,
/
&PHYSICS
  nu = 1.0e-6, sgs_model = 0,
/
&NUMERICS
  dt = 1.0e-3, nsteps = -1, nsave = 100000, nmonitor = 10, cfl_adaptive = 1, cfl_target = 0.4, cfl_safety = 0.9,
  dt_max = 5.0e-3, sim_end_time = 7.0,
/
&BOUNDARY_CONDITIONS
  bc_face_ylo = 2, bc_face_yhi = 2, x_bc_type = 1, y_bc_type = 1, z_bc_type = 0,
/
&INFLOW
  inflow_type = 3,
/
&INITIAL_CONDITIONS
  Utarget = 0.0, ic_type = 3, noise_percent = 0.0, restart = 0,
/
&IO
  filein = 'restart/x', fileout = 'flume',
/
&WAVES
  wave_type = 2, wave_height = 0.08, wave_period = 1.2, wave_gen_len = 1.0, wave_ramp_time = 2.0, wave_abs_len = 2.0, wave_relax_rate = 20.0,
  wave_gauge_x = 2.0, 2.4, 2.8, 3.2, 3.6, 4.0,
/
&VOF
  vof_active = 1, vof_flow = 1, vof_ic_type = 1, vof_level = 0.5,
  vof_rho_l = 100.0, vof_rho_g = 1.0, vof_nu_l = 1.0e-6, vof_nu_g = 1.5e-5, vof_grav = 9.81,
/
