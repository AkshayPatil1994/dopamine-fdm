! Two-fluid sloshing wave, density ratio 1000: standing wave of wavelength 1 (amplitude 0.02, depth 0.5 each fluid, closed free-slip lids).
! Run until t=1.7, then `python3 analyze.py vof_diag.dat 1000 1`: half-period error against the two-layer linear dispersion relation
! is +0.35 % with the default settings (spike C: +0.5 %). Also check: still water (vof_wave_amp=0) stays at rest to round-off.
&DOMAIN
  nx = 66, ny = 65, nz = 6,
  Lx = 1.015625, Ly = 1.0, Lz = 0.078125,
  grid_type = 1, alpha_grid = 1.0, alpha_grid_z = 0.0, p_row = 0, p_col = 0,
/
&PHYSICS
  nu = 1.0e-6, sgs_model = 0,
/
&NUMERICS
  dt = 1.0e-3, nsteps = -1, nsave = 100000, nmonitor = 1, cfl_adaptive = 1, cfl_target = 0.4, cfl_safety = 0.9,
  dt_max = 4.0e-3, sim_end_time = 1.7,
/
&BOUNDARY_CONDITIONS
  bc_face_ylo = 2, bc_face_yhi = 2, x_bc_type = 0, y_bc_type = 1, z_bc_type = 0,
/
&INITIAL_CONDITIONS
  Utarget = 0.0, ic_type = 3, noise_percent = 0.0, restart = 0,
/
&IO
  filein = 'restart/x', fileout = 'slosh',
/
&VOF
  vof_active = 1, vof_flow = 1, vof_ic_type = 4, vof_level = 0.5, vof_wave_amp = 0.02, vof_wave_lambda = 1.0,
  vof_rho_l = 1000.0, vof_rho_g = 1.0, vof_nu_l = 1.0e-6, vof_nu_g = 1.5e-5, vof_grav = 9.81, vof_pcg_iters = 3,
/
