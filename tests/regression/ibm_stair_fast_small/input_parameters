! ibm_stair_small with the whole-box fast Poisson projection (ibm_projection = 1): rank-count and layout parity.

&DOMAIN
  nx         = 34,
  ny         = 17,
  nz         = 34,
  Lx         = 6.0,
  Ly         = 2.0,
  Lz         = 3.0,
  grid_type  = 1,
  alpha_grid = 2.0,
  p_row      = 0,
  p_col      = 0,
/

&PHYSICS
  nu                   = 0.002531645569620253,
  dPdx                 = 1.0,
  dPdz                 = 0.0,
  sgs_model            = 1,
  Cs_vreman            = 0.17,
  flat_wall_model_flag = 1,
/

&NUMERICS
  dt           = 0.002,
  nsteps       = 20,
  nsave        = 20,
  nmonitor     = 1,
  cfl_adaptive = 0, pcg_precond = 1,
/

&BOUNDARY_CONDITIONS
  bc_face_ylo = 1,
  bc_face_yhi = 1,
  x_bc_type = 0,
  y_bc_type = 1,
  z_bc_type = 0,
/

&INITIAL_CONDITIONS
  Utarget      = 5.0,
  ic_type      = 4,
  noise_percent  = 5.0,
  nstep_init     = 0,
  restart        = 0,
/

&IO
  filein  = 'restart/ibm_wm_small.1',
  fileout = 'ibm_wm_small',
/

&IBM
  ibm_input_mode = 1,
  ibm_method = 1, ibm_projection = 1, ibm_wall_model_flag = 1,
  ibm_sdf_file = 'SDF_in',
/
