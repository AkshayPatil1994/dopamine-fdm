! chan_les_small + Boussinesq temperature + on-the-fly time-averaged statistics (velocity and T, fields/tavg_small_tavg.20 compared too)


&DOMAIN
  nx         = 18,
  ny         = 17,
  nz         = 18,
  Lx         = 3.0,
  Ly         = 2.0,
  Lz         = 1.5,
  grid_type  = 2,
  alpha_grid = 2.0,
  p_row      = 0,
  p_col      = 0,
/

&PHYSICS
  nu                   = 0.002531645569620253,
  dPdx                 = 1.0,
  dPdz                 = 0.0,
  sgs_model            = 1,
  Cs_vreman            = 0.17,
  flat_wall_model_flag = 1,
/

&NUMERICS
  dt           = 0.002,
  nsteps       = 20,
  nsave        = 20,
  nmonitor     = 1,
  cfl_adaptive = 0,
/

&BOUNDARY_CONDITIONS
  bc_face_ylo = 1,
  bc_face_yhi = 1,
  x_bc_type = 0,
  y_bc_type = 1,
  z_bc_type = 0,
/

&INITIAL_CONDITIONS
  Utarget      = 5.0,
  ic_type      = 4,
  noise_percent  = 5.0,
  nstep_init     = 0,
  restart        = 0,
/

&IO
  filein  = 'restart/tavg_small.1',
  fileout = 'tavg_small',
/

&BOUSSINESQ
  boussinesq_flag = 1,
  beta_T = 3.0e-3,
  T_ref = 0.0,
  grav = 9.81,
  Pr = 0.7,
  Pr_t = 0.85,
  T_bc_bot = 1, T_bc_top = 1,
  T_wall_bot = 1.0, T_wall_top = 0.0,
  T_ic_type = 1,
  T_ic_grad = -0.5,
/

&STATISTICS
  tavg_active = 1, tavg_T = 1,
/
