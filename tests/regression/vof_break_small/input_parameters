! ================================================================
! Steep (ak = 0.5) Stokes wave at 1000:1 on a 2-D strip: the interface crosses every x rank seam obliquely. Variable-density
! transport, pressure and viscous terms must give the same fields for every rank layout (regression for the padded density at the
! duplicate face of non-last x ranks). Checks: volume to round-off, C in [0,1], np1 = np4 to 1e-9 (tight PCG tolerance).
! ================================================================

&DOMAIN
  nx         = 50,
  ny         = 49,
  nz         = 6,
  Lx         = 1.0208333333,
  Ly         = 1.0,
  Lz         = 0.1041666667,
  grid_type  = 1,
  p_row      = 0,
  p_col      = 0,
/

&PHYSICS
  nu      = 1.0e-6,
  sgs_model = 0,
/

&NUMERICS
  dt           = 1.0e-3,
  nsteps       = 30,
  nsave        = 1000000,
  nmonitor     = 10,
  cfl_adaptive = 1,
  cfl_target   = 0.4,
  cfl_safety   = 0.9,
  dt_max       = 4.0e-3,
/

&BOUNDARY_CONDITIONS
  bc_face_ylo = 2,
  bc_face_yhi = 2,
  x_bc_type   = 0,
  y_bc_type   = 1,
  z_bc_type   = 0,
/

&INITIAL_CONDITIONS
  Utarget       = 0.0,
  ic_type       = 3,
  noise_percent = 0.0,
  restart       = 0,
/

&IO
  filein  = 'restart/x',
  fileout = 'break',
/

&VOF
  vof_active = 1, vof_flow = 1, vof_ic_type = 4, vof_level = 0.5, vof_wave_amp = 0.0795774715, vof_wave_lambda = 1.0,
  vof_wave_stokes = 1, vof_rho_l = 1000.0, vof_rho_g = 1.0, vof_nu_l = 1.0e-6, vof_nu_g = 1.5e-5, vof_grav = 9.81, vof_pcg_tol = 1e-10, vof_pcg_iters = 400, vof_adv_iters = 60, vof_adv_tol = 1d-12,
/
