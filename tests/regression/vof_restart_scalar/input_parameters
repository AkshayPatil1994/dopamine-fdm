! Restart parity of the two-fluid solver with a sediment slab and a stratified temperature (N + N steps equal 2N, fixed dt).
&DOMAIN
  nx = 34, ny = 33, nz = 6,
  Lx = 1.03125, Ly = 1.0, Lz = 0.15625,
  grid_type = 1, alpha_grid = 1.0, alpha_grid_z = 0.0, p_row = 0, p_col = 0,
/
&PHYSICS
  nu = 1.0e-6, sgs_model = 0,
/
&NUMERICS
  dt = 2.0e-3, nsteps = 10, nsave = 10, nmonitor = 7, cfl_adaptive = 0,
/
&BOUNDARY_CONDITIONS
  bc_face_ylo = 2, bc_face_yhi = 2, x_bc_type = 0, y_bc_type = 1, z_bc_type = 0,
/
&INITIAL_CONDITIONS
  Utarget = 0.0, ic_type = 3, noise_percent = 0.0, restart = 0, nstep_init = 0,
/
&IO
  filein = 'restart/vof_restart_scalar.1', fileout = 'vof_restart_scalar',
/
&VOF
  vof_active = 1, vof_flow = 1, vof_ic_type = 4, vof_level = 0.5, vof_wave_amp = 0.02, vof_wave_lambda = 1.0,
  vof_rho_l = 1000.0, vof_rho_g = 1.0, vof_nu_l = 1.0e-6, vof_nu_g = 1.5e-5, vof_grav = 9.81,
/

&SEDIMENT
  sediment_flag = 1, d_s = 1.0e-4, rho_s = 2650.0, rho_f = 1000.0, Sc = 1.0, Sc_t = 1.0, C_ref = 1.0, sed_bc_bot = 0, C_ic_type = 3, C_ic_height = 0.5,
/
&BOUSSINESQ
  boussinesq_flag = 1, beta_T = 2.0e-4, T_ref = 20.0, grav = 9.81, Pr = 7.0, Pr_t = 0.85, T_ic_type = 1, T_ic_grad = 5.0,
/
