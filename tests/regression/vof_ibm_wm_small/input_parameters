! IBM bump (synthetic SDF_in of ibm_wm_small) with the smooth IBM wall model in the two-fluid solver, all liquid, decaying uniform stream:
! the ghost viscosity follows the phase at the reference cell; 1 and 4 ranks must agree.
! Tiny periodic-x/z channel, LES (Vreman) + smooth equilibrium wall model, stretched y grid,
! laminar Reichardt profile + prescribed sinusoidal perturbation, no random noise) used as a
! rank-count / CPU-vs-GPU parity case exercising the wall-normal tridiagonal Poisson path.

&DOMAIN
  nx         = 34,
  ny         = 17,
  nz         = 34,
  Lx         = 6.0,
  Ly         = 2.0,
  Lz         = 3.0,
  grid_type  = 1,
  alpha_grid = 2.0,
  p_row      = 0,
  p_col      = 0,
/

&PHYSICS
  nu = 1.0e-6,
  dPdx = 0.0,
  dPdz                 = 0.0,
  sgs_model            = 1,
  Cs_vreman            = 0.17,
  flat_wall_model_flag = 0,
/

&NUMERICS
  dt           = 0.002,
  nsteps = 40,
  nsave = 100000,
  nmonitor = 10,
  cfl_adaptive = 0,
/

&BOUNDARY_CONDITIONS
  bc_face_ylo = 1,
  bc_face_yhi = 1,
  x_bc_type = 0,
  y_bc_type = 1,
  z_bc_type = 0,
/

&INITIAL_CONDITIONS
  Utarget = 1.0,
  ic_type = 7,
  noise_percent = 0.0,
  nstep_init     = 0,
  restart        = 0,
/

&IO
  filein  = 'restart/ibm_wm_small.1',
  fileout = 'ibm_wm_small',
/

&IBM
  ibm_input_mode = 1,
  ibm_wall_model_flag = 1,
  ibm_sdf_file = 'SDF_in',
/
&VOF
  vof_active = 1, vof_flow = 1, vof_ic_type = 1, vof_level = 2.0,
  vof_rho_l = 1000.0, vof_rho_g = 1.2, vof_nu_l = 1.0e-6, vof_nu_g = 1.5e-5, vof_grav = 0.0, vof_pcg_tol = 1e-10, vof_pcg_iters = 400,
/
