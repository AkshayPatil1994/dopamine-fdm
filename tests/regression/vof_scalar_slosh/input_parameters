! Two-fluid slosh with a passive scalar of uniform concentration in both phases (rho_s = rho_f: no settling): C must stay uniform.
&DOMAIN
  nx = 66, ny = 65, nz = 6,
  Lx = 1.015625, Ly = 1.0, Lz = 0.078125,
  grid_type = 1, alpha_grid = 1.0, alpha_grid_z = 0.0, p_row = 0, p_col = 0,
/
&PHYSICS
  nu = 1.0e-6, sgs_model = 0,
/
&NUMERICS
  dt = 1.0e-3, nsteps = -1, nsave = -1, tsave = 0.3, nmonitor = 5, cfl_adaptive = 1, cfl_target = 0.4, cfl_safety = 0.9,
  dt_max = 4.0e-3, sim_end_time = 0.3,
/
&BOUNDARY_CONDITIONS
  bc_face_ylo = 2, bc_face_yhi = 2, x_bc_type = 0, y_bc_type = 1, z_bc_type = 0,
/
&INITIAL_CONDITIONS
  Utarget = 0.0, ic_type = 3, noise_percent = 0.0, restart = 0,
/
&IO
  filein = 'restart/x', fileout = 'scalar_slosh',
/
&VOF
  vof_active = 1, vof_flow = 1, vof_ic_type = 4, vof_level = 0.5, vof_wave_amp = 0.02, vof_wave_lambda = 1.0,
  vof_rho_l = 1000.0, vof_rho_g = 1.0, vof_nu_l = 1.0e-6, vof_nu_g = 1.5e-5,
/

&SEDIMENT
  sediment_flag = 1, d_s = 1.0e-4, rho_s = 1000.0, rho_f = 1000.0, Sc = 1.0, Sc_t = 1.0, C_ref = 1.0, sed_bc_bot = 0, C_ic_type = 0,
/
