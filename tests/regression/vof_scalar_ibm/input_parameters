! Two-fluid solver around the ghost-cell IBM sphere of vof_ibm_small (SDF read from that case) with sediment and an isothermal body
! (ibm_T_bc_type=1) in a stratified Boussinesq temperature: the IBM scalar ghost fills and the solid-cell fallback of the temperature BC
! on the device. CPU vs GPU parity of the final snapshot (all field blocks).
&DOMAIN
  nx = 34, ny = 17, nz = 34, Lx = 6.0, Ly = 2.0, Lz = 3.0, grid_type = 1, alpha_grid = 2.0, p_row = 0, p_col = 0,
/

&PHYSICS
  grav = 0.0,
  nu = 0.01, sgs_model = 0,
/

&NUMERICS
  dt = 0.01, nsteps = 10, nsave = 10, nmonitor = 4, cfl_adaptive = 0,
/

&BOUNDARY_CONDITIONS
  bc_face_ylo = 1, bc_face_yhi = 1, x_bc_type = 0, y_bc_type = 1, z_bc_type = 0,
/

&INITIAL_CONDITIONS
  Utarget = 0.0, ic_type = 3, noise_percent = 0.0, restart = 0,
/

&IO
  filein = 'restart/vof_scalar_ibm.1', fileout = 'vof_scalar_ibm',
/

&IBM
  ibm_input_mode = 1, ibm_wall_model_flag = 0, ibm_sdf_file = '../vof_ibm_small/SDF_in',
  ibm_T_bc_type(0) = 1, ibm_T_wall(0) = 30.0,
/

&VOF
  vof_active = 1, vof_flow = 1, vof_ic_type = 1, vof_level = 10.0, vof_rho_l = 1.0, vof_rho_g = 1.0, vof_pcg_tol = 1e-12, vof_pcg_iters = 400, vof_adv_iters = 60, vof_adv_tol = 1d-12,
  vof_nu_l = 0.01, vof_nu_g = 0.01, vof_u0 = 1.0, vof_mom_scheme = 0,
/

&SEDIMENT
  sediment_flag = 1, d_s = 1.0e-4, rho_s = 2650.0, rho_f = 1.0, Sc = 1.0, Sc_t = 1.0, C_ref = 1.0, sed_bc_bot = 0, C_ic_type = 0,
/
&BOUSSINESQ
  boussinesq_flag = 1, beta_T = 2.0e-4, T_ref = 20.0, Pr = 7.0, Pr_t = 0.85, T_ic_type = 1, T_ic_grad = 1.0,
  T_bc_bot = 0, T_bc_top = 0,
/
