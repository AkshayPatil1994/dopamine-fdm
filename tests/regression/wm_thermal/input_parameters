! Single-phase LES: a uniform stream over a rough wall with the MOST heat-flux wall model (T_bc = 2), starting from uniform T = T_ref.
! The check compares the heat the fluid has gained (the applied wall flux) with the MOST flux u_tau*theta_tau of the matching-height state.
&DOMAIN
  nx = 18, ny = 33, nz = 18, Lx = 1.0, Ly = 1.0, Lz = 1.0, grid_type = 1, alpha_grid = 1.0, p_row = 1, p_col = 1,
/
&PHYSICS
  nu = 1.0e-5, sgs_model = 1, Cs_vreman = 0.1, flat_wall_model_flag = 2, z0_ylo = 1e-3, z0_yhi = 1e-3, z0h_ylo = 1e-4, z0h_yhi = 1e-4,
/
&NUMERICS
  dt = 2.0e-3, nsteps = 40, nsave = 40, nmonitor = 10, cfl_adaptive = 0,
/
&BOUNDARY_CONDITIONS
  bc_face_ylo = 1, bc_face_yhi = 1, x_bc_type = 0, y_bc_type = 1, z_bc_type = 0,
/
&INITIAL_CONDITIONS
  Utarget = 1.0, ic_type = 7, noise_percent = 0.0, restart = 0,
/
&IO
  filein = 'restart/x', fileout = 'x',
/
&BOUSSINESQ
  boussinesq_flag = 1, beta_T = 0.0, T_ref = 300.0, grav = 9.81, Pr = 0.7, Pr_t = 0.85,
  T_bc_bot = 2, T_bc_top = 0, T_wall_bot = 301.0, T_wall_top = 300.0, T_ic_type = 0,
/
