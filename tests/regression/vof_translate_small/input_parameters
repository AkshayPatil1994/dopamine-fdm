! ================================================================
! Passive VOF translation: a liquid sphere carried by a uniform periodic stream (constant-mass-flux forcing on a zero field gives
! U = Ub_target exactly; free-slip y walls). Checks, in vof_diag.dat: liquid volume conserved to round-off, C within [0,1] with
! no clipping, centroid advancing at Ub_target, and identical output for every rank count / p_row x p_col layout.
! ================================================================

&DOMAIN
  nx         = 34,
  ny         = 33,
  nz         = 34,
  Lx         = 1.03125,
  Ly         = 1.0,
  Lz         = 1.03125,
  grid_type  = 1,
  p_row      = 0,
  p_col      = 0,
/

&PHYSICS
  nu                = 1.0e-3,
  sgs_model         = 0,
  flow_forcing_mode = 1,
  Ub_target         = 1.0,
/

&NUMERICS
  dt           = 8.0e-3,
  nsteps       = 40,
  nsave        = 40,
  nmonitor     = 10,
  cfl_adaptive = 0,
/

&BOUNDARY_CONDITIONS
  bc_face_ylo = 2,
  bc_face_yhi = 2,
  x_bc_type   = 0,
  y_bc_type   = 1,
  z_bc_type   = 0,
/

&INITIAL_CONDITIONS
  Utarget       = 0.0,
  ic_type       = 3,
  noise_percent = 0.0,
  restart       = 0,
/

&IO
  filein  = 'restart/vof_translate_small.1',
  fileout = 'vof_translate_small',
/

&VOF
  vof_active        = 1,
  vof_ic_type       = 2,
  vof_center        = 0.3, 0.5, 0.5,
  vof_radius        = 0.15,
  vof_normal_scheme = 1,
/
