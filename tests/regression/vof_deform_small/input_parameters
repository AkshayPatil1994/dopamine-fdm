! ================================================================
! Enright 3-D deformation test of the VOF transport inside the full solver (passive mode, vof_flow=0): a liquid sphere
! (radius 0.15 at (0.35,0.35,0.35)) in the analytic divergence-free field of Enright et al. (2002), reversed at t=T/2 (T=3),
! must return to its initial shape at t=T. Checked in vof_diag.dat by tests/regression/vof_check.py: volume to round-off, C in
! [0,1], L1(C - C_init) below the stored bound, identical for every rank count / pencil layout (x and z halos both active).
! ================================================================

&DOMAIN
  nx         = 26,
  ny         = 25,
  nz         = 26,
  Lx         = 1.0416666666666667,
  Ly         = 1.0,
  Lz         = 1.0416666666666667,
  grid_type  = 1,
  p_row      = 0,
  p_col      = 0,
/

&PHYSICS
  nu        = 1.0e-3,
  sgs_model = 0,
/

&NUMERICS
  dt           = 0.025,
  nsteps       = 120,
  nsave        = 1000000,
  nmonitor     = 20,
  cfl_adaptive = 0,
/

&BOUNDARY_CONDITIONS
  bc_face_ylo = 2,
  bc_face_yhi = 2,
  x_bc_type   = 0,
  y_bc_type   = 1,
  z_bc_type   = 0,
/

&INITIAL_CONDITIONS
  Utarget       = 0.0,
  ic_type       = 3,
  noise_percent = 0.0,
  restart       = 0,
/

&IO
  filein  = 'restart/vof_deform_small.1',
  fileout = 'vof_deform_small',
/

&VOF
  vof_active        = 1,
  vof_ic_type       = 2,
  vof_center        = 0.35, 0.35, 0.35,
  vof_radius        = 0.15,
  vof_prescribed    = 2,
  vof_presc_T       = 3.0,
  vof_normal_scheme = 1,
/
