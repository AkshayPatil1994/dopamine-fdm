! Uniform stream (no turbulence, no pressure gradient) over a rough wall whose matching height is above the first cell, free-slip lid.
! Every cell below the matching height decays by the quadratic drag law of the wall model, which has a closed-form solution.
&DOMAIN
  nx = 18, ny = 65, nz = 18, Lx = 18.0, Ly = 64.0, Lz = 18.0, grid_type = 1, alpha_grid = 1.0, p_row = 1, p_col = 1,
/
&PHYSICS
  nu = 1.0e-5, dPdx = 0.0, sgs_model = 0, flat_wall_model_flag = 2, z0_ylo = 0.1,
/
&NUMERICS
  dt = 0.2, nsteps = 500, nsave = 500, nmonitor = 250, cfl_adaptive = 0,
/
&BOUNDARY_CONDITIONS
  bc_face_ylo = 1, bc_face_yhi = 2, x_bc_type = 0, y_bc_type = 1, z_bc_type = 0,
/
&INITIAL_CONDITIONS
  Utarget = 1.0, ic_type = 7, noise_percent = 0.0, restart = 0,
/
&IO
  filein = 'restart/x', fileout = 'x',
/
