! ================================================================
! Reversed-vortex test of the VOF transport inside the full solver (passive mode, vof_flow=0): a liquid disk is carried by the
! analytic LeVeque stream function psi = sin^2(pi x) sin^2(pi y)/pi cos(pi t/T) (T=2), reaches maximum deformation at t=T/2 and
! must return to its initial shape at t=T. Checked in vof_diag.dat by tests/regression/vof_check.py: liquid volume conserved to
! round-off, C inside [0,1], L1(C - C_init) below the stored bound, identical for every rank count / pencil layout.
! 2-D problem on a thin periodic slab (nz=6). Reference at N=64: L1 = 5.7e-5 (T=2), 9.8e-4 (T=8); standalone advection test 4.0e-5, 5.5e-4.
! ================================================================

&DOMAIN
  nx         = 50,
  ny         = 49,
  nz         = 6,
  Lx         = 1.0208333333333333,
  Ly         = 1.0,
  Lz         = 0.10416666666666667,
  grid_type  = 1,
  p_row      = 0,
  p_col      = 0,
/

&PHYSICS
  nu        = 1.0e-3,
  sgs_model = 0,
/

&NUMERICS
  dt           = 8.333333333333333e-3,
  nsteps       = 240,
  nsave        = 1000000,
  nmonitor     = 30,
  cfl_adaptive = 0,
/

&BOUNDARY_CONDITIONS
  bc_face_ylo = 2,
  bc_face_yhi = 2,
  x_bc_type   = 0,
  y_bc_type   = 1,
  z_bc_type   = 0,
/

&INITIAL_CONDITIONS
  Utarget       = 0.0,
  ic_type       = 3,
  noise_percent = 0.0,
  restart       = 0,
/

&IO
  filein  = 'restart/vof_vortex_small.1',
  fileout = 'vof_vortex_small',
/

&VOF
  vof_active        = 1,
  vof_ic_type       = 6,
  vof_center        = 0.5, 0.75, 0.0,
  vof_radius        = 0.15,
  vof_prescribed    = 1,
  vof_presc_T       = 2.0,
  vof_normal_scheme = 1,
/
