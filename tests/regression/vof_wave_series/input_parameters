! Wave flume driven by an elevation record (wave_type = 4): a Gaussian-modulated 1 Hz packet of amplitude 0.01 m (series.txt is generated by
! check_series.py), deep-water components, generation zone 0.5 m, absorption zone 1 m, density ratio 1000.
! check_series.py: the run completes, fields/wave_series_check.out reports a small reconstruction error, the gauges at x = 1.0 and 1.5 see the
! packet at the group speed with the record amplitude, and the liquid ledger closes.
&DOMAIN
  nx = 98, ny = 33, nz = 6,
  Lx = 3.03125, Ly = 1.0, Lz = 0.15625,
  grid_type = 1, alpha_grid = 1.0, alpha_grid_z = 0.0, p_row = 0, p_col = 0,
/
&PHYSICS
  nu = 1.0e-6, sgs_model = 0,
/
&NUMERICS
  dt = 1.0e-3, nsteps = -1, nsave = 100000, nmonitor = 10, cfl_adaptive = 1, cfl_target = 0.4, cfl_safety = 0.9,
  dt_max = 5.0e-3, sim_end_time = 6.0,
/
&BOUNDARY_CONDITIONS
  bc_face_ylo = 2, bc_face_yhi = 2, x_bc_type = 1, y_bc_type = 1, z_bc_type = 0,
/
&INFLOW
  inflow_type = 3,
/
&INITIAL_CONDITIONS
  Utarget = 0.0, ic_type = 3, noise_percent = 0.0, restart = 0,
/
&IO
  filein = 'restart/x', fileout = 'flume',
/
&WAVES
  wave_type = 4, wave_series_file = 'series.txt', wave_gen_len = 0.5, wave_abs_len = 1.0, wave_relax_rate = 20.0,
  wave_gauge_x = 1.0, 1.5, 2.0,
/
&VOF
  vof_active = 1, vof_flow = 1, vof_ic_type = 1, vof_level = 0.5,
  vof_rho_l = 1000.0, vof_rho_g = 1.0, vof_nu_l = 1.0e-6, vof_nu_g = 1.5e-5,
/
