! Precursor-like column (same y grid, Ly, z0, free-slip lid, matching height j_m = 52 of the Michel-Stadt precursor) with a small
! horizontal extent and a uniform initial stream: the column momentum balance gives the bulk deceleration to compare against.
&DOMAIN
  nx = 16, ny = 123, nz = 16, Lx = 120.0, Ly = 240.0, Lz = 120.0, grid_type = 6, alpha_grid = 1.0, p_row = 1, p_col = 1,
/
&PHYSICS
  nu = 1.5e-5, dPdx = 1.450417e-03, sgs_model = 0, flat_wall_model_flag = 2, z0_ylo = 1.57, advection_scheme = 1,
/
&NUMERICS
  dt = 0.05, nsteps = 200, nsave = 200, nmonitor = 100, cfl_adaptive = 0,
/
&BOUNDARY_CONDITIONS
  bc_face_ylo = 1, bc_face_yhi = 2, x_bc_type = 0, y_bc_type = 1, z_bc_type = 0,
/
&IBM
  ibm_input_mode = 0, ks = 30.0, nks = 48,
/
&INITIAL_CONDITIONS
  Utarget = 7.7, ic_type = 7, noise_percent = 0.0, restart = 0,
/
&IO
  filein = 'restart/x', fileout = 'x',
/
