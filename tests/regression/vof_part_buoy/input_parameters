! Light inertial particles (bubbles) rising through still water: they reach the free surface and are reflected there, none ends in the gas.
&DOMAIN
  nx = 34, ny = 33, nz = 6,
  Lx = 1.03125, Ly = 1.0, Lz = 0.15625,
  grid_type = 1, alpha_grid = 1.0, alpha_grid_z = 0.0, p_row = 0, p_col = 0,
/
&PHYSICS
  nu = 1.0e-6, sgs_model = 0,
/
&NUMERICS
  dt = 4.0e-3, nsteps = 800, nsave = 800, nmonitor = 100, cfl_adaptive = 0,
/
&BOUNDARY_CONDITIONS
  bc_face_ylo = 2, bc_face_yhi = 2, x_bc_type = 0, y_bc_type = 1, z_bc_type = 0,
/
&INITIAL_CONDITIONS
  Utarget = 0.0, ic_type = 3, noise_percent = 0.0, restart = 0,
/
&IO
  filein = 'restart/x', fileout = 'part_buoy',
/
&VOF
  vof_active = 1, vof_flow = 1, vof_ic_type = 4, vof_level = 0.5, vof_wave_amp = 0.0, vof_wave_lambda = 1.0,
  vof_rho_l = 1000.0, vof_rho_g = 1.0, vof_nu_l = 1.0e-6, vof_nu_g = 1.5e-5, vof_grav = 9.81,
/

&PARTICLES
  particles_active = 1, n_particles_init = 200, particle_seed_seed = 11,
  particle_seed_xmin = 0.0, particle_seed_xmax = 1.03, particle_seed_ymin = 0.10, particle_seed_ymax = 0.40,
  particle_seed_zmin = 0.0, particle_seed_zmax = 0.15,
  bc_particle_x = 2, bc_particle_y = 2, bc_particle_z = 0, particle_mode = 1, particle_diam = 1.0e-3, particle_rho = 1.0, particle_rho_f = 1000.0,
/
&SEDIMENT
  sediment_flag = 0, grav = 9.81,
/
