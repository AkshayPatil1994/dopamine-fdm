! Tiny channel with a synthetic-eddy-method inflow (inflow_type 1) and convective outflow: bit-identity and rank-count case of the SEM inlet.

&DOMAIN
  nx         = 34,
  ny         = 17,
  nz         = 18,
  Lx         = 3.0,
  Ly         = 2.0,
  Lz         = 1.5,
  grid_type  = 2,
  alpha_grid = 2.0,
  p_row      = 0,
  p_col      = 0,
/

&PHYSICS
  nu                   = 0.002531645569620253,
  dPdx                 = 1.0,
  dPdz                 = 0.0,
  sgs_model            = 1,
  Cs_vreman            = 0.17,
  flat_wall_model_flag = 1,
/

&NUMERICS
  dt           = 0.002,
  nsteps       = 20,
  nsave        = 20,
  nmonitor     = 1,
  cfl_adaptive = 0,
/

&BOUNDARY_CONDITIONS
  bc_face_ylo = 1,
  bc_face_yhi = 1,
  x_bc_type = 1,
  y_bc_type = 1,
  z_bc_type = 0,
/

&INFLOW
  inflow_type = 1,
  inflow_Uconst = 5.0,
  inflow_profile_file = 'inflow_profile.dat',
  sem_n_eddies = 40,
  sem_length_scale = 0.3,
  sem_seed = 4711,
  sem_ensemble_samples = 20,
  sem_ensemble_periods = 2,
  sem_use_esem = 1,
/

&INITIAL_CONDITIONS
  Utarget      = 5.0,
  ic_type      = 4,
  noise_percent  = 5.0,
  nstep_init     = 0,
  restart        = 0,
/

&IO
  filein  = 'restart/sem_inflow_small.1',
  fileout = 'sem_inflow_small',
/
