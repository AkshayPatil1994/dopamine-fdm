! Single phase, staircase IBM (ibm_method = 1): a rough block (id 1, z0 = 1e-2) on a smooth plate (id 2), built at run time by check_ids.py.
! The wall stress on the block's staircase faces must not depend on the orientation of the stream (mirror test).
&DOMAIN
  nx = 18, ny = 33, nz = 18, Lx = 1.0, Ly = 1.0, Lz = 1.0, grid_type = 1, alpha_grid = 1.0, p_row = 0, p_col = 0,
/
&PHYSICS
  nu = 1.0e-6, sgs_model = 1, Cs_vreman = 0.1,
/
&NUMERICS
  dt = 2.0e-3, nsteps = 100, nsave = 100000, nmonitor = 50, cfl_adaptive = 0,
/
&BOUNDARY_CONDITIONS
  bc_face_ylo = 1, bc_face_yhi = 2, x_bc_type = 0, y_bc_type = 1, z_bc_type = 0,
/
&INITIAL_CONDITIONS
  Utarget = 1.0, ic_type = 7, noise_percent = 0.0, restart = 0,
/
&IO
  filein = 'restart/x', fileout = 'x',
/
&IBM
  ibm_input_mode = 1, ibm_method = 1, nsampling = 1, ibm_wall_model_flag = 1, ibm_sdf_file = 'SDF_in', ibm_objid_file = 'OBJ_in', ibm_z0(1) = 1.0e-2, ibm_z0(2) = 0.0,
/
