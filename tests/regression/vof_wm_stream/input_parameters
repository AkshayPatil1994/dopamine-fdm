! Uniform 1 m/s stream over a no-slip, wall-modelled bed under a free-slip lid, all liquid: the mean velocity decays by the log-law wall stress
! rho u_tau^2 of the first-cell velocity (the check integrates it), independent of the liquid density; np1 vs np4 agree.
&DOMAIN
  nx = 18, ny = 33, nz = 18, Lx = 1.0, Ly = 1.0, Lz = 1.0, grid_type = 1, alpha_grid = 1.0, p_row = 0, p_col = 0,
/
&PHYSICS
  nu = 1.0e-6, sgs_model = 1, Cs_vreman = 0.1, flat_wall_model_flag = 1,
/
&NUMERICS
  dt = 2.0e-3, nsteps = 150, nsave = 100000, nmonitor = 20, cfl_adaptive = 0,
/
&BOUNDARY_CONDITIONS
  bc_face_ylo = 1, bc_face_yhi = 2, x_bc_type = 0, y_bc_type = 1, z_bc_type = 0,
/
&INITIAL_CONDITIONS
  Utarget = 1.0, ic_type = 7, noise_percent = 0.0, restart = 0,
/
&IO
  filein = 'restart/x', fileout = 'x',
/
&VOF
  vof_active = 1, vof_flow = 1, vof_ic_type = 1, vof_level = 1.0,
  vof_rho_l = 1000.0, vof_rho_g = 1.2, vof_nu_l = 1.0e-6, vof_nu_g = 1.5e-5, vof_grav = 0.0, vof_pcg_tol = 1e-10, vof_pcg_iters = 400,
/
