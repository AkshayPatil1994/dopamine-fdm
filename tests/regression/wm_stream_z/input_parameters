! Single-phase LES: a uniform 1 m/s stream along x between two no-slip, smooth wall-modelled spanwise (z) walls decays by the log-law wall
! stress u_tau^2 of the first-cell velocity at both walls (the check integrates it); 1 and 4 ranks (split along z) agree.
&DOMAIN
  nx = 18, ny = 18, nz = 34, Lx = 1.0, Ly = 1.0, Lz = 1.0, grid_type = 1, alpha_grid = 1.0, p_row = 1, p_col = 1,
/
&PHYSICS
  nu = 1.0e-6, sgs_model = 1, Cs_vreman = 0.1, flat_wall_model_flag = 1,
/
&NUMERICS
  dt = 2.0e-3, nsteps = 150, nsave = 100000, nmonitor = 10, cfl_adaptive = 0,
/
&BOUNDARY_CONDITIONS
  bc_face_ylo = 1, bc_face_yhi = 1, x_bc_type = 0, y_bc_type = 0, z_bc_type = 1,
/
&INITIAL_CONDITIONS
  Utarget = 1.0, ic_type = 7, noise_percent = 0.0, restart = 0,
/
&IO
  filein = 'restart/x', fileout = 'x',
/
