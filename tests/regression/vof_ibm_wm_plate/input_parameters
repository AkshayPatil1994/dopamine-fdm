! Flat IBM plate (synthetic SDF_in: solid below y = 0.25) under a uniform 1 m/s stream, all liquid, IBM wall model on: the stress is the log-law rho u_tau^2
! on the staircase faces, so the mean velocity decays as the integrated law (check_wm_plate.py), independent of the liquid density, same on 1 and 4 ranks.
&DOMAIN
  nx = 18, ny = 33, nz = 18, Lx = 1.0, Ly = 1.0, Lz = 1.0, grid_type = 1, alpha_grid = 1.0, p_row = 0, p_col = 0,
/
&PHYSICS
  nu = 1.0e-6, sgs_model = 1, Cs_vreman = 0.1,
/
&NUMERICS
  dt = 2.0e-3, nsteps = 150, nsave = 100000, nmonitor = 50, cfl_adaptive = 0,
/
&BOUNDARY_CONDITIONS
  bc_face_ylo = 1, bc_face_yhi = 2, x_bc_type = 0, y_bc_type = 1, z_bc_type = 0,
/
&INITIAL_CONDITIONS
  Utarget = 1.0, ic_type = 7, noise_percent = 0.0, restart = 0,
/
&IO
  filein = 'restart/x', fileout = 'x',
/
&IBM
  ibm_input_mode = 1, ibm_wall_model_flag = 1, ibm_sdf_file = 'SDF_in',
/
&VOF
  vof_active = 1, vof_flow = 1, vof_ic_type = 1, vof_level = 1.0,
  vof_rho_l = 1000.0, vof_rho_g = 1.2, vof_nu_l = 1.0e-6, vof_nu_g = 1.5e-5, vof_grav = 0.0, vof_pcg_tol = 1e-10, vof_pcg_iters = 400,
/
