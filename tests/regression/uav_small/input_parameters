! Tiny periodic-x/z channel, LES (Vreman) + smooth equilibrium wall model, stretched y grid,
! laminar Reichardt profile + prescribed sinusoidal perturbation, no random noise) used as a
! rank-count / CPU-vs-GPU parity case exercising the wall-normal tridiagonal Poisson path.

&DOMAIN
  nx         = 18,
  ny         = 17,
  nz         = 18,
  Lx         = 3.0,
  Ly         = 2.0,
  Lz         = 1.5,
  grid_type  = 2,
  alpha_grid = 2.0,
  p_row      = 0,
  p_col      = 0,
/

&PHYSICS
  nu                   = 0.002531645569620253,
  dPdx                 = 1.0,
  dPdz                 = 0.0,
  sgs_model            = 1,
  Cs_vreman            = 0.17,
  flat_wall_model_flag = 1,
/

&NUMERICS
  dt           = 0.002,
  nsteps       = 20,
  nsave        = 20,
  nmonitor     = 1,
  cfl_adaptive = 0,
/

&BOUNDARY_CONDITIONS
  bc_face_ylo = 1,
  bc_face_yhi = 1,
  x_bc_type = 0,
  y_bc_type = 1,
  z_bc_type = 0,
/

&INITIAL_CONDITIONS
  Utarget      = 5.0,
  ic_type      = 4,
  noise_percent  = 5.0,
  nstep_init     = 0,
  restart        = 0,
/

&IO
  filein  = 'restart/uav_small.1',
  fileout = 'uav_small',
/

&UAV
  uav_active = 1,
  uav_xc = 1.5, uav_yc = 1.0, uav_zc = 0.75,
  uav_disk_radius = 0.4, uav_n_r = 6, uav_n_theta = 12,
  uav_hover_thrust = 2.0, uav_kernel_ncell = 2,
  uav_load_profile = 1, uav_swirl_frac = 0.1,
/
