! Static drop on a 2-D problem with a z extent of 17 cells: the pressure field written to the snapshot must be identical for 1 rank and
! a 2x2 layout (x and z seams), in particular no plane at a seam may be zero (check_pressure.py).
&DOMAIN
  nx = 34, ny = 33, nz = 18, Lx = 1.03125, Ly = 1.0, Lz = 0.53125, grid_type = 1, alpha_grid = 1.0, alpha_grid_z = 0.0, p_row = 0, p_col = 0,
/
&PHYSICS
  nu = 1.0e-3, sgs_model = 0,
/
&NUMERICS
  dt = 1.0e-3, nsteps = 20, nsave = 20, nmonitor = 5, cfl_adaptive = 1, cfl_target = 0.4, cfl_safety = 0.9,
  dt_max = 5.0e-2, 
/
&BOUNDARY_CONDITIONS
  bc_face_ylo = 2, bc_face_yhi = 2, x_bc_type = 0, y_bc_type = 1, z_bc_type = 0,
/
&INITIAL_CONDITIONS
  Utarget = 0.0, ic_type = 3, noise_percent = 0.0, restart = 0,
/
&IO
  filein = 'restart/vof_p_seam.1', fileout = 'vof_p_seam',
/
&VOF
  vof_active = 1, vof_flow = 1, vof_ic_type = 6, vof_center = 0.5, 0.5, 0.0, vof_radius = 0.25,
  vof_rho_l = 1000.0, vof_rho_g = 1.0, vof_nu_l = 1.0e-3, vof_nu_g = 1.0e-3, vof_grav = 0.0, vof_sigma = 1.0,
/
