! ================================================================
! Ghost-cell IBM sphere (synthetic SDF_in of ibm_small, straddling the rank seams) in a closed no-slip channel with the two-fluid
! solver on a single fluid (vof_ic_type=1 with the interface above the box, equal densities): impulsive start from U=1. The flow
! is that of the single-phase solver with the same input (vof_active=0, ic_type=7): mean U at t=1 is 0.7945 against 0.7955
! (0.12 %), max|U| 1.4409 against 1.4416. tests/regression/vof_check.py requires the diagnostics of 1 and 4 ranks to agree
! (ratio-1 flows are layout independent to round-off; the halo of the sweep divergence Dd was missing before).
! ================================================================

&DOMAIN
  nx = 34, ny = 17, nz = 34, Lx = 6.0, Ly = 2.0, Lz = 3.0, grid_type = 1, alpha_grid = 2.0, p_row = 0, p_col = 0,
/

&PHYSICS
  nu = 0.01, sgs_model = 0,
/

&NUMERICS
  dt = 0.01, nsteps = 100, nsave = 1000, nmonitor = 10, cfl_adaptive = 0,
/

&BOUNDARY_CONDITIONS
  bc_face_ylo = 1, bc_face_yhi = 1, x_bc_type = 0, y_bc_type = 1, z_bc_type = 0,
/

&INITIAL_CONDITIONS
  Utarget = 0.0, ic_type = 3, noise_percent = 0.0, restart = 0,
/

&IO
  filein = 'restart/vof_ibm_small.1', fileout = 'vof_ibm_small',
/

&IBM
  ibm_input_mode = 1, ibm_wall_model_flag = 0, ibm_sdf_file = 'SDF_in',
/

&VOF
  vof_active = 1, vof_flow = 1, vof_ic_type = 1, vof_level = 10.0, vof_rho_l = 1.0, vof_rho_g = 1.0,
  vof_nu_l = 0.01, vof_nu_g = 0.01, vof_grav = 0.0, vof_u0 = 1.0, vof_mom_scheme = 0,
/
