! Strong noise in a slow uniform stream with a staircase body: reversed flow enters through the outlet. outflow_backflow_beta = 1 keeps it bounded, 0 blows up.

&DOMAIN
  nx         = 34,
  ny         = 17,
  nz         = 34,
  Lx         = 6.0,
  Ly         = 2.0,
  Lz         = 3.0,
  grid_type  = 1,
  alpha_grid = 2.0,
  p_row      = 0,
  p_col      = 0,
/

&PHYSICS
  nu                   = 0.002531645569620253,
  dPdx                 = 0.0,
  dPdz                 = 0.0,
  sgs_model            = 1,
  Cs_vreman            = 0.17,
  flat_wall_model_flag = 1,
/

&NUMERICS
  dt           = 0.002,
  nsteps       = 1500,
  nsave        = 100000,
  nmonitor     = 100,
  cfl_adaptive = 1, cfl_target = 0.8, dt_max = 0.01, pcg_precond = 1,
/

&BOUNDARY_CONDITIONS
  bc_face_ylo = 1,
  bc_face_yhi = 1,
  x_bc_type = 1,
  outflow_backflow_beta = 1.0,
  y_bc_type = 1,
  z_bc_type = 0,
/

&INFLOW
  inflow_type = 0,
  inflow_Uconst = 0.3,
/

&INITIAL_CONDITIONS
  Utarget      = 0.3,
  ic_type      = 7,
  noise_percent  = 400.0,
  nstep_init     = 0,
  restart        = 0,
/

&IO
  filein  = 'restart/ibm_wm_small.1',
  fileout = 'ibm_wm_small',
/

&IBM
  ibm_input_mode = 1,
  ibm_method = 1, ibm_pressure = 2, ibm_wall_model_flag = 1,
  ibm_sdf_file = 'SDF_in',
/
