! Wave + current flume with the turbulence of a recycled precursor slice at the inlet (wave_turb = 1), faded out above the free surface.
! check_turb_inlet.py writes a synthetic donor (z-periodic u', w' of amplitude 0.05 over the whole depth, air included) and runs with and without it.
&DOMAIN
  nx = 98, ny = 33, nz = 6,
  Lx = 3.03125, Ly = 1.0, Lz = 0.15625,
  grid_type = 1, alpha_grid = 1.0, alpha_grid_z = 0.0, p_row = 0, p_col = 0,
/
&PHYSICS
  nu = 1.0e-6, sgs_model = 0,
/
&NUMERICS
  dt = 1.0e-3, nsteps = -1, nsave = 100000, nmonitor = 10, cfl_adaptive = 1, cfl_target = 0.4, cfl_safety = 0.9,
  dt_max = 5.0e-3, sim_end_time = 1.5,
/
&BOUNDARY_CONDITIONS
  bc_face_ylo = 2, bc_face_yhi = 2, x_bc_type = 1, y_bc_type = 1, z_bc_type = 0,
/
&INFLOW
  inflow_type = 3, inflow_recycle_file = 'donor', inflow_recycle_loop = 1, inflow_recycle_shift_z = 0,
/
&INITIAL_CONDITIONS
  Utarget = 0.0, ic_type = 3, noise_percent = 0.0, restart = 0,
/
&IO
  filein = 'restart/x', fileout = 'flume',
/
&WAVES
  wave_type = 1, wave_height = 0.01, wave_period = 1.0, wave_gen_len = 0.5, wave_ramp_time = 0.5, wave_abs_len = 1.0, current_type = 2, current_U = 0.2, wave_turb = 1, wave_relax_rate = 20.0,
  wave_gauge_x = 1.0, 1.5, 2.0,
/
&VOF
  vof_active = 1, vof_flow = 1, vof_ic_type = 1, vof_level = 0.5,
  vof_rho_l = 1000.0, vof_rho_g = 1.0, vof_nu_l = 1.0e-6, vof_nu_g = 1.5e-5, vof_grav = 9.81,
/
