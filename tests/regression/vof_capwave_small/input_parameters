! ================================================================
! Capillary standing wave, density ratio 1000, no gravity (lambda=1, depth 0.5 each fluid, a=0.01, sigma=20): inviscid theory
! omega^2 = sigma k^3 /(rho_l coth(kh) + rho_g coth(kh)) = 4.938, i.e. T = 2.83. The measured frequency (zero crossings of the
! cosine moment, column 15 of vof_diag.dat) must be within 1 % of theory (N=32: -0.46 %, N=64: -0.15 %).
! ================================================================
&DOMAIN
  nx = 34, ny = 33, nz = 6, Lx = 1.03125, Ly = 1.0, Lz = 0.15625, grid_type = 1, alpha_grid = 1.0, alpha_grid_z = 0.0, p_row = 0, p_col = 0,
/
&PHYSICS
  nu = 1.0e-3, sgs_model = 0,
/
&NUMERICS
  dt = 1.0e-3, nsteps = -1, nsave = 1000000, nmonitor = 5, cfl_adaptive = 1, cfl_target = 0.4, cfl_safety = 0.9,
  dt_max = 5.0e-2, sim_end_time = 4.3,
/
&BOUNDARY_CONDITIONS
  bc_face_ylo = 2, bc_face_yhi = 2, x_bc_type = 0, y_bc_type = 1, z_bc_type = 0,
/
&INITIAL_CONDITIONS
  Utarget = 0.0, ic_type = 3, noise_percent = 0.0, restart = 0,
/
&IO
  filein = 'restart/vof_capwave_small.1', fileout = 'vof_capwave_small',
/
&VOF
  vof_active = 1, vof_flow = 1, vof_ic_type = 4, vof_level = 0.5, vof_wave_amp = 0.01, vof_wave_lambda = 1.0,
  vof_rho_l = 1000.0, vof_rho_g = 1.0, vof_nu_l = 1.0e-6, vof_nu_g = 1.5e-5, vof_grav = 0.0, vof_sigma = 20.0,
/
