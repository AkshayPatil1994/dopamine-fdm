! Restart parity with the wave inlet, relaxation zones, LES (Vreman) and a no-slip bed: N + N steps equals 2N straight steps (fixed dt).
&DOMAIN
  nx = 194, ny = 33, nz = 6,
  Lx = 6.03125, Ly = 1.0, Lz = 0.15625,
  grid_type = 1, alpha_grid = 1.0, alpha_grid_z = 0.0, p_row = 0, p_col = 0,
/
&PHYSICS
  nu = 1.0e-6, sgs_model = 1, Cs_vreman = 0.1,
/
&NUMERICS
  dt = 5.0e-3, nsteps = 10, nsave = 10, nmonitor = 5, cfl_adaptive = 0,
  
/
&BOUNDARY_CONDITIONS
  bc_face_ylo = 1, bc_face_yhi = 2, x_bc_type = 1, y_bc_type = 1, z_bc_type = 0,
/
&INFLOW
  inflow_type = 3,
/
&INITIAL_CONDITIONS
  Utarget = 0.0, ic_type = 3, noise_percent = 0.0, restart = 0, nstep_init = 0,
/
&IO
  filein = 'restart/x', fileout = 'flume',
/
&WAVES
  wave_type = 1, wave_height = 0.04, wave_period = 1.0, wave_gen_len = 1.0, wave_ramp_time = 0.5, wave_abs_len = 2.0, wave_relax_rate = 20.0,
  wave_gauge_x = 2.0, 2.4, 2.8, 3.2, 3.6, 4.0,
/
&VOF
  vof_active = 1, vof_flow = 1, vof_ic_type = 1, vof_level = 0.5,
  vof_rho_l = 1000.0, vof_rho_g = 1.0, vof_nu_l = 1.0e-6, vof_nu_g = 1.5e-5, vof_grav = 9.81, vof_pcg_tol = 1e-8, vof_pcg_iters = 100,
/
