# GenSDF control file — solver Example 06
# Flow around a sphere — LES, Re_D ≈ 3700
#
# Sphere: D = 0.1 m, centre at (0.4, 0.4, 0.4) m  (4D from inlet in 16D domain)
# Domain: Lx=1.6 × Ly=0.8 × Lz=0.8 m
#
# Run as:  mpirun -np <N> ../../gensdf_mpi   (N >= 2, from this directory)
# Output:  data/sdfu.bin  data/sdfv.bin  data/sdfw.bin  data/sdfp.bin
#
# Copy data/sdfp.bin → SDF_in in the solver run directory.
# Set ibm_sdf_input = 1 in solver input_parameters.

# Geometry filename
'data/sphere.stl'
# scalarvalue  buffer_points  pbarwidth
1d10  5  40
# Grid dimensions nx ny nz (cell-centre counts = nxm, nym, nzm)
191 95 95
# Domain origin
0.0 0.0 0.0
# Non-uniform z grid
.false.
# Use fast-sweep
.true.
# Narrow-band width
5
# Vertical (wall-normal) axis of the solver (2 = y-vertical, 3 = z-vertical)
3
# Compute face-staggered SDFs (sdfu, sdfv, sdfw) in addition to cell-centre sdfp
.true.
